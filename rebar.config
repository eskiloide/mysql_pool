{deps, [
    {mysql, ".*", {git, "https://github.com/mysql-otp/mysql-otp.git", {ref, "1afd59677b3e2daf795f5fd77268e1dbc20f4c51"}}},
    {poolboy, ".*", {git, "https://github.com/devinus/poolboy.git", {tag, "1.5.2"}}},
    {plists, ".*", {git, "https://github.com/silviucpp/plists.git", {tag, "1.1.3"}}}
]}.

{project_plugins, [rebar3_hex]}.

{erl_opts, [
    warnings_as_errors ,
    warn_export_all
]}.
